{
  "schema_version": 1,
  "services": [
    {
      "name": "payments-fake",
      "command": ["python3", "-m", "pledge.fakes.payments", "--port", "14000"],
      "health": "http://127.0.0.1:14000/healthz"
    },
    {
      "name": "app",
      "command": ["python3", "app.py"],
      "env": { "PORT": "13000", "PAYMENTS_URL": "http://127.0.0.1:18081", "SHOP_DB": "/tmp/shop.db" },
      "health": "http://127.0.0.1:13000/healthz"
    }
  ],
  "routes": {
    "app": { "listen": 18080, "upstream": "http://127.0.0.1:13000" },
    "payments": { "listen": 18081, "upstream": "http://127.0.0.1:14000" }
  },
  "target": "http://127.0.0.1:18080",
  "reset": ["http://127.0.0.1:14000/_fake/reset"]
}
