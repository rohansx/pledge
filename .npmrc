# Workspace packages are consumed as TypeScript source (each package's "main" points at
# src/index.ts), so no package needs a build step before another can import it. Parallel
# agents must never have to run a build to unblock each other.
link-workspace-packages=true

# next-auth v5 only exists on the beta tag. Without this, pnpm's peer resolution refuses
# prerelease matches and the install fails on a version that is the documented v0 target.
strict-peer-dependencies=false
