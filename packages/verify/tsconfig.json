{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The CLI is run directly by node (`bin` points at src/cli.ts, and node >= 22.18 strips
    // types on the fly), so this package must contain nothing node would have to compile
    // rather than erase, and every type-only import must say so. Both options turn a
    // violation into a typecheck failure instead of a runtime crash on someone else's
    // machine, which is the only place this tool ever runs.
    // (`allowImportingTsExtensions` is in tsconfig.base.json — consumers need it too.)
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test", "fixtures"]
}
