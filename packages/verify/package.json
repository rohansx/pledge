{
  "name": "pledge-verify",
  "version": "0.1.0",
  "description": "Offline verifier for pledge receipts (pledge.receipt.v1): canonical hash + ed25519 signature, steps 1-2 of receipt-format.md §4. Never contacts the issuer.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pledge-verify": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "fixtures": "node fixtures/generate.ts"
  },
  "dependencies": {
    "@pledge/ledger": "workspace:*",
    "zod": "4.4.3"
  }
}
