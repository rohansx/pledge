{
  "name": "pledge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "node scripts/check-invariants.mjs && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/check-invariants.mjs && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:invariants": "node scripts/check-invariants.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @pledge/db migrate",
    "db:seed": "pnpm --filter @pledge/db seed",
    "ledger:verify": "pnpm --filter @pledge/db ledger:verify",
    "worker": "pnpm --filter @pledge/worker start",
    "smoke": "pnpm --filter @pledge/worker smoke",
    "notify": "pnpm --filter @pledge/web notify"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "pledge-verify": "workspace:*"
  }
}
