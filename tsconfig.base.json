{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    // packages/verify is run directly by node (`bin` → src/cli.ts, type-stripped on the fly),
    // so its relative imports carry the `.ts` extension node needs to resolve them. Every
    // project here is noEmit, which is the condition this option requires, and any package
    // importing the verifier has to allow the extension too — so it is set once, centrally,
    // rather than rediscovered as a typecheck failure in each consumer.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "types": ["node"]
  }
}
