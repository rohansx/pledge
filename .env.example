# pledge — environment
# Copy to .env.local for local dev. Every value below is read at startup and validated;
# a missing one fails loudly rather than degrading silently.

# --- Database -----------------------------------------------------------------------
# Full-privilege connection used by apps/web and by migrations.
# Local: `pnpm db:up` starts the Postgres in docker-compose.yml on host port 5433.
# Prod: the Neon primary connection string (Neon dashboard → Connection Details).
DATABASE_URL=postgres://pledge:pledge@localhost:5433/pledge

# Restricted connection used by apps/worker. This is the `pledge_probe` role, which has
# column-level SELECT on commitment and INSERT on probe_run and NOTHING on account —
# architecture.md §4. The role and its grants are created by the first migration.
# Never point the worker at DATABASE_URL: the isolation is the control that survives an
# SSRF bypass (security.md T-01, control 7).
DATABASE_URL_PROBE=postgres://pledge_probe:pledge_probe@localhost:5433/pledge

# --- Auth ---------------------------------------------------------------------------
# Auth.js session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app credentials, used for login and to claim the handle from the GitHub
# login. Create at https://github.com/settings/developers → New OAuth App.
# Authorization callback URL: ${NEXT_PUBLIC_BASE_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Probes -------------------------------------------------------------------------
# Token used by the github.release probe against api.github.com only. A fine-grained PAT
# with public-repo read is enough for v0 (https://github.com/settings/tokens).
# Raises the rate limit from 60/hr to 5000/hr; a resolution-critical run must never fall
# back to unauthenticated (architecture.md §8).
GITHUB_APP_TOKEN=

# --- Email --------------------------------------------------------------------------
# Resend API key for commit and resolution mails. https://resend.com/api-keys
RESEND_API_KEY=

# --- Deployment role ----------------------------------------------------------------
# Worker entrypoints refuse to start unless this is exactly "worker". It is set in
# production and NOWHERE else — a preview deployment that probes would double-probe real
# commitments from an unpinned egress IP (architecture.md §9).
PLEDGE_ROLE=web

# --- Public config ------------------------------------------------------------------
# Origin the app is served from. Used for OAuth callbacks and for absolute links in mail.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
