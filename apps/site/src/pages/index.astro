---
import Base from '../layouts/Base.astro';
import Waitlist from '../components/Waitlist.astro';
import Demo from '../components/Demo.astro';

const title = 'Pledge — prove your app keeps its promises';
const description =
  'Pledge boots your app in a sandbox, injects retries, duplicate webhooks, races and restarts, and checks your data against pledges that must always hold. Claude writes the checks. Code decides the verdict.';

const pillars = [
  { n: '01 · CLAUDE WRITES', h: 'Scenarios, pledges and planted bugs', p: 'Claude reads your repo, boots it, and writes users, journeys and the rules your data must keep.' },
  { n: '02 · CODE DECIDES', h: 'Deterministic checks on real state', p: "The verdict comes from your database and the fakes' call logs. A model never says pass or fail." },
  { n: '03 · PROOF GATES TRUST', h: 'Every pledge must break once', p: "A bug is planted in a fork. If the pledge doesn't catch it, it can't block a merge." },
];

const faultsA = [['Retry', 'double charge'], ['Duplicate delivery', 'work done twice'], ['Same-instant', 'oversold stock'], ['Reorder', 'wrong final state']];
const faultsB = [['Delay', 'timeouts'], ['Restart', 'half-finished writes'], ['Webhook storm', 'idempotency'], ['Slow dependency', 'retries pile up']];

// `vis` is trusted static markup for each tile's mini terminal.
const tiles = [
  { step: '01 · DISCOVER', h: 'Read the repo', p: 'Stack, migrations, routes, and every call to a third party.',
    vis: '<pre><span class="d">$ discover</span>\nstack     node · pg · redis\nroutes    42\noutbound  <span class="hl">stripe</span> · <span class="hl">postmark</span>\nenv       17 vars</pre>' },
  { step: '02 · BOOT & SNAPSHOT', h: 'Boot it for real', p: 'Retry until healthy, then save the sandbox against the commit.',
    vis: '<pre>npm ci          <span class="ok">ok</span>\npg migrate      <span class="ok">ok</span>\nGET /health     <span class="no">502</span>\nGET /health     <span class="ok">200</span>\n<span class="hl">snapshot</span> sb_7f3a</pre>' },
  { step: '03 · SEED', h: 'Realistic data', p: 'A starting dataset made through your own API where it can.',
    vis: '<pre>users      200\nproducts   80\norders     1,140\n<span class="d">via POST /api/*</span></pre>' },
  { step: '04 · AUTHOR', h: 'Write the pledges', p: 'Scenarios plus checks, each with the source it came from.',
    vis: '<div class="big q">One charge per payment.</div><div class="src">source · unique index on payment_id</div>' },
  { step: '05 · BASELINE', h: 'Run clean first', p: 'A pledge broken with no faults is a bug or a wrong pledge. A human looks.',
    vis: '<pre>faults    none\nseeds     8\npledges   12  <span class="ok">kept 11</span>\n          <span class="no">broken 1</span> → review</pre>' },
  { step: '06 · PROVE', h: 'Plant a bug', p: "The pledge must catch it in a fork. Unproven pledges can't block merges.",
    vis: '<pre><span class="d">- if (exists(key)) return</span>\n<span class="no">+ // planted: skip check</span>\npledge    <span class="ok">broke ✓ proven</span></pre>' },
  { step: '07 · FAULT RUNS', h: 'Many seeds at once', p: 'Each fork gets its own seed and fault plan. Seeds scale only when results disagree.',
    vis: '<pre>fork 01 ▮▮▮▮▮▮ <span class="ok">kept</span>\nfork 02 ▮▮▮▮▮▮ <span class="ok">kept</span>\nfork 03 ▮▮▮<span class="no">▮</span>▮▮ <span class="no">broke</span>\nfork 04 ▮▮▮▮▮▮ <span class="ok">kept</span>\n<span class="d">… 40 forks</span></pre>' },
  { step: '08 · VERDICT', h: 'A count, with evidence', p: 'Kept and broken per pledge, the smallest failing plan, and how to replay it.',
    vis: '<pre>broken on 7/40 seeds\nmin plan  <span class="hl">retry POST /checkout</span>\nexpected  1 charge\nactual    <span class="no">2 charges</span>\nreplay    pledge replay r_91c</pre>' },
];

const bugs = [
  { k: 'Double charge', q: 'One charge per payment.', p: 'The client times out, retries, and the server charges again because nothing checks the idempotency key.', fault: 'retry', area: 'payments' },
  { k: 'Oversold stock', q: 'Stock never goes below zero.', p: 'Two checkouts read the same count at the same instant and both decrement it.', fault: 'same-instant', area: 'inventory' },
  { k: 'Work done twice', q: 'Each webhook is processed once.', p: 'The provider delivers twice, as providers do, and the order ships twice.', fault: 'duplicate', area: 'webhooks' },
  { k: 'Credits spent twice', q: 'A credit is spent at most once.', p: 'Parallel requests both pass the balance check before either writes.', fault: 'same-instant', area: 'credits' },
  { k: 'Half-finished write', q: 'Every paid order has a receipt.', p: 'The app restarts between the charge and the insert. Money taken, no order.', fault: 'restart', area: 'consistency' },
  { k: 'Wrong final state', q: 'A refunded order stays refunded.', p: '“Refunded” arrives before “paid”, and the late event wins.', fault: 'reorder', area: 'state' },
];

const states = [
  { b: 'Proposed', color: '#9A938D', p: 'Claude wrote it from a constraint, a domain template, or its reading of your code. Inferred pledges are always shown for review first.' },
  { b: 'Proven', color: 'var(--amber)', p: 'It broke on a planted bug in a fork, so it is known to be able to fail.' },
  { b: 'Approved', color: '#6BC08A', p: 'A human accepted it. It now runs as a check on every pull request.', rule: true },
  { b: 'Retired', color: '#77706B', p: 'Removed from any state. History stays in git.' },
];

const prSteps = [
  ['Rebuild from the recipe', 'The stored boot recipe replays at the new commit. No agent needed.'],
  ['Scope to the diff', 'Only scenarios whose routes or files changed run again.'],
  ['Run approved pledges', 'Proven, human-approved pledges run under their fault plans.'],
  ['Re-author when it matters', 'New routes, or a change to a file a pledge came from, bring Claude back in.'],
  ['Comment with evidence', 'A broken pledge posts the seeds, the smallest fault plan, expected versus actual, and a replay command.'],
];
---
<Base title={title} description={description}>
  <!-- Pledge mark: a solid seal with the check cut out. One fill, no hairlines, so it stays crisp at 16px. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <mask id="mark-cut" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
        <rect width="24" height="24" fill="#fff" />
        <path d="M6.5 12.5 10 16l7.5-8" fill="none" stroke="#000" stroke-width="2.75" stroke-linecap="square" stroke-linejoin="miter" />
      </mask>
    </defs>
    <symbol id="mark" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="12" fill="currentColor" mask="url(#mark-cut)" />
    </symbol>
  </svg>

  <nav class="nav" aria-label="Main">
    <div class="nav-in glass ticks">
      <a class="logo" href="/" aria-label="Pledge home"><svg width="20" height="20" aria-hidden="true"><use href="#mark" /></svg>pledge</a>
      <div class="links">
        <a href="#how">How it works</a>
        <a href="#faults">Faults</a>
        <a href="#file">Pledge files</a>
        <a href="#security">Security</a>
      </div>
      <div class="nav-cta">
        <button class="theme" id="theme" type="button" aria-label="Toggle dark mode">
          <svg class="sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <svg class="moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        </button>
        <a class="btn btn-dark" href="#join">Join waitlist</a>
      </div>
    </div>
  </nav>

  <main>
    <header class="hero wrap">
      <h1>Your app made promises.<span>Prove it keeps them.</span></h1>
      <p class="sub">Pledge boots your app in a sandbox, throws retries, duplicate webhooks, races and restarts at it, then checks your data against the rules it must never break.</p>

      <div class="join glass ticks" id="join">
        <div class="join-head"><span>Join the waitlist</span><a href="#how">How a scan works ↓</a></div>
        <Waitlist />
        <p class="foot-note">First design-partner scans go out in waves. One email when it's your turn.</p>
      </div>

      <Demo />
    </header>

    <section aria-labelledby="pillars-h">
      <div class="wrap center">
        <h2 class="reveal" id="pillars-h">A verdict you can replay, not an opinion</h2>
        <p class="lede">A pledge is a statement about your data that must always hold. Pledge proves each one can fail, then tries to make it fail.</p>
        <div class="pillars">
          {pillars.map((x) => (
            <div class="pillar glass fade"><div class="n">{x.n}</div><h3>{x.h}</h3><p>{x.p}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section id="faults" aria-labelledby="faults-h">
      <div class="wrap">
        <div class="panel">
          <div>
            <div class="eyebrow">Fault proxy</div>
            <h2 class="reveal" id="faults-h" style="margin-top:22px">Everything production<br />does to you, on a seed</h2>
            <p class="lede">The proxy sits on every inbound request and every outbound call. Same seed, same fault plan, so every finding comes with a replay command.</p>
          </div>
          <div>
            <div class="marquee"><div class="marquee-track" data-dup>
              {faultsA.map(([n, b]) => <span class="chip glass">{n}<small>{b}</small></span>)}
            </div></div>
            <div class="marquee rev"><div class="marquee-track" data-dup>
              {faultsB.map(([n, b]) => <span class="chip glass">{n}<small>{b}</small></span>)}
            </div></div>
            <p class="foot-note">+ Third-party calls go to recording fakes. A test never charges a real card.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="how" aria-labelledby="how-h">
      <div class="wrap">
        <div class="eyebrow">First scan</div>
        <h2 class="reveal" id="how-h" style="margin-top:18px">Boot once. Break it many ways.</h2>
        <p class="lede">A first scan runs in one isolated microVM. The healthy app is snapshotted, and every proof and fault run forks it.</p>
        <div class="grid4">
          {tiles.map((t) => (
            <article class="tile fade">
              <div class="vis texture" set:html={t.vis} />
              <div class="step">{t.step}</div><h3>{t.h}</h3><p>{t.p}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="file" aria-labelledby="file-h">
      <div class="wrap">
        <div class="feature glass fade">
          <div class="code texture" aria-label="Example pledge file">
            <div class="path"><span>.pledge/pledges/one-charge-per-payment.yaml</span><span>yaml</span></div>
            <div><span class="key">id</span>: one-charge-per-payment</div>
            <div><span class="key">statement</span>: <span class="str">"A payment is charged exactly once."</span></div>
            <div><span class="key">check</span>:</div>
            <div>&nbsp;&nbsp;<span class="key">observer</span>: fake_payments.charges</div>
            <div>&nbsp;&nbsp;<span class="key">group_by</span>: payment_id</div>
            <div>&nbsp;&nbsp;<span class="key">expect</span>: {'{'} count: <span class="acc">1</span> {'}'}</div>
            <div><span class="key">source</span>: domain-template/payments</div>
            <div><span class="key">confidence</span>: medium</div>
            <div><span class="key">status</span>: <span class="acc">approved</span>&nbsp;&nbsp;<span class="cm"># proposed → proven → approved</span></div>
            <div><span class="key">proof</span>:</div>
            <div>&nbsp;&nbsp;<span class="key">patch</span>: proofs/skip-idempotency-key.diff</div>
            <div>&nbsp;&nbsp;<span class="key">broke</span>: <span class="acc">true</span></div>
          </div>
          <div class="feature-txt">
            <div class="eyebrow">Everything is a file</div>
            <h3 id="file-h">Your pledges live in your repo, reviewed like code.</h3>
            <p>Scenarios, pledges, fault plans and evidence are plain files. Your team owns them, changes show up in review, and they keep working with the open-source CLI if you ever leave.</p>
            <div class="row"><a class="btn btn-dark" href="#join">Join the waitlist →</a><a class="btn btn-line" href="#demo">See a run</a></div>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="bugs-h">
      <div class="wrap">
        <div class="head-row">
          <div><div class="eyebrow">What it catches</div><h2 class="reveal" id="bugs-h" style="margin-top:18px">Bugs your test suite passes</h2></div>
          <div class="arrows"><button class="glass" type="button" aria-label="Previous" data-dir="-1">←</button><button class="glass" type="button" aria-label="Next" data-dir="1">→</button></div>
        </div>
        <div class="cards" id="cards">
          {bugs.map((b, i) => (
            <article class="bug glass">
              <div class="k1">{b.k}<span>{String(i + 1).padStart(2, '0')}</span></div>
              <div class="q">{b.q}</div>
              <p>{b.p}</p>
              <div class="by"><span>Fault · {b.fault}</span><span>{b.area}</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="states-h">
      <div class="wrap">
        <div class="dark texture">
          <div>
            <div class="eyebrow" style="color:var(--dark-mute)">Pledge lifecycle</div>
            <h2 class="reveal" id="states-h" style="margin-top:22px">Only proven, approved pledges block a merge</h2>
            <p class="lede">Claude can propose anything. Only a pledge that has been proven and accepted by a human can fail your pull request.</p>
          </div>
          <div>
            {states.map((s) => (
              <div class="state glass-dark fade"><b style={`color:${s.color}`}>{s.b}</b><p class={s.rule ? 'rule' : undefined}>{s.p}</p></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="security" aria-labelledby="sec-h">
      <div class="wrap">
        <div class="sec">
          <div class="eyebrow" style="justify-content:center">Isolation</div>
          <h2 class="reveal" id="sec-h" style="margin-top:18px">The agent never enters the sandbox</h2>
          <p class="lede">Your code is treated as untrusted. API keys, the GitHub token and the orchestrator stay outside the machine that runs it.</p>
          <div class="sigils">
            <div class="sigil glass"><svg width="48" height="48" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8" y="8" width="40" height="40" rx="2" /><rect x="18" y="18" width="20" height="20" rx="1" stroke-dasharray="3 3" /></svg>MicroVM<br />per scan</div>
            <div class="sigil glass"><svg width="48" height="48" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="28" cy="28" r="20" /><path d="M8 28h40M28 8c-7 8-7 32 0 40M28 8c7 8 7 32 0 40" /><path d="M12 12l32 32" stroke="var(--seal)" stroke-width="2" /></svg>Network closed<br />after install</div>
            <div class="sigil glass"><svg width="48" height="48" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="10" y="16" width="36" height="24" rx="2" /><path d="M10 23h36" /><path d="M16 33h10" stroke-dasharray="2 3" /></svg>Fakes, not<br />providers</div>
            <div class="sigil glass"><svg width="48" height="48" aria-hidden="true"><use href="#mark" /></svg>Redacted<br />evidence</div>
          </div>
          <div class="pills">
            {['No production secrets', 'One evidence prefix per customer', 'Customer-set deletion', 'Repo text is data', 'Bring your own cloud'].map((p) => <span class="pill glass">{p}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="pr-h">
      <div class="wrap split">
        <div class="sticky">
          <div class="eyebrow">Pull requests</div>
          <h2 class="reveal" id="pr-h" style="margin-top:22px">Then it runs on every pull request</h2>
          <p class="lede">After the first scan, a pull request skips discovery and authoring. It rebuilds the snapshot and reruns only what the diff touches.</p>
        </div>
        <ol class="items" style="list-style:none">
          {prSteps.map(([h, p], i) => (
            <li class="item fade"><div class="n">{String(i + 1).padStart(2, '0')}</div><div><h3>{h}</h3><p>{p}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section aria-labelledby="wl-h">
      <div class="wrap">
        <div class="cta texture">
          <div>
            <svg width="30" height="30" aria-hidden="true" style="color:#F4EFE9"><use href="#mark" /></svg>
            <h2 id="wl-h">Find out which promises your app breaks.</h2>
            <p class="lede">Claude writes the checks. Code decides the verdict. A model never does.</p>
          </div>
          <a class="btn" href="#join" data-focus-join>Join the waitlist ↑</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <div class="foot texture">
      <div></div>
      <div class="cols">
        <div><h4>Product</h4><a href="#how">How it works</a><a href="#faults">Faults</a><a href="#file">Pledge files</a><a href="#security">Security</a></div>
        <div><h4>Pledge</h4><a href="#join">Waitlist</a><a href="#demo">Example run</a></div>
      </div>
      <div class="foot-bottom">
        <span class="logo"><svg width="24" height="24" aria-hidden="true"><use href="#mark" /></svg>pledge</span>
        <small>© {new Date().getFullYear()} Pledge</small>
      </div>
    </div>
  </footer>

  <script>
    import '../scripts/ui.ts';
    import '../scripts/demo.ts';
  </script>
</Base>
