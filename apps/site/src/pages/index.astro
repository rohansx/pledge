---
import Base from '../layouts/Base.astro';
import Waitlist from '../components/Waitlist.astro';
import Demo from '../components/Demo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroStory from '../components/HeroStory.astro';

const title = 'Pledge — find the bugs your tests miss';
const description =
  'Retries, duplicate webhooks and race conditions quietly charge customers twice, oversell stock and ship orders twice. Pledge finds them in a sandbox and shows you exactly how to replay them.';

// The 40 runs of one rule; the same seven break everywhere on the page (hero comment, step 3, Hairline figure).
const BROKEN = new Set([3, 9, 14, 21, 26, 33, 38]);
const runs = Array.from({ length: 40 }, (_, i) => BROKEN.has(i + 1));

// Step diagrams (trusted static SVG), styled under .diag in global.css.
const codeLines = [70, 52, 80, 44, 62].map((w, i) => `<path class="ln" d="M30 ${54 + i * 13}h${w}"/>`).join('');
const runGrid = runs.map((bad, i) =>
  `<rect class="${bad ? 'no' : 'ok'}" x="${63 + (i % 10) * 18}" y="${44 + Math.floor(i / 10) * 18}" width="13" height="13" rx="1"/>`).join('');
const ruleDiag = `<rect class="bx" x="20" y="22" width="110" height="110" rx="2"/><text class="m" x="30" y="40">checkout.ts</text>${codeLines}
  <path class="ln" d="M140 77h34" marker-end="url(#arr)"/><text class="m" x="157" y="68" text-anchor="middle">reads</text>
  <rect class="bx hi" x="182" y="47" width="100" height="60" rx="2"/><text class="m" x="192" y="64">RULE</text>
  <text class="t" x="192" y="82">One charge</text><text class="t" x="192" y="97">per payment.</text>`;
const proofDiag = `<text class="t" x="63" y="32">One charge per payment.</text>${runGrid}
  <text class="ft" x="63" y="134">broke on 7 of 40 runs</text><text class="m" x="238" y="134" text-anchor="end">replay ↗</text>`;

const bugs = [
  { k: 'Double charge', q: 'One charge per payment.', p: 'A retry charges the card again.', fault: 'retry' },
  { k: 'Oversold stock', q: 'Stock never goes below zero.', p: 'Two checkouts buy the last item.', fault: 'race' },
  { k: 'Work done twice', q: 'Each webhook is processed once.', p: 'A webhook arrives twice. The order ships twice.', fault: 'duplicate' },
  { k: 'Credits spent twice', q: 'A credit is spent at most once.', p: 'Parallel requests spend one balance twice.', fault: 'race' },
  { k: 'Half-finished write', q: 'Every paid order has a receipt.', p: 'A restart after the charge. Money taken, no order.', fault: 'restart' },
  { k: 'Wrong final state', q: 'A refunded order stays refunded.', p: 'Events arrive out of order and the late one wins.', fault: 'reorder' },
];

const compare = [
  ['Checks', 'code paths', 'uptime', 'your data'],
  ['Effort', 'you write them', 'you configure them', 'writes them for you'],
  ['Output', 'pass / fail', 'dashboards', 'a failing PR with a replay'],
];

const trust = [
  ['Rules live in your repo', 'Plain files, reviewed like code. Only rules you approve can block a merge.'],
  ['Claude writes, code decides', 'Claude proposes the rules. Plain code checks the data and gives the verdict.'],
  ['Isolated sandbox', 'No network after install, fake payment providers, no production secrets.'],
];
---
<Base title={title} description={description}>
  <Nav />

  <main>
    <header class="hero wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">Fault testing for your data</div>
          <h1>Find the bugs your tests miss,<span> before your customers do.</span></h1>
          <p class="sub">{description}</p>

          <div class="join glass" id="join">
            <div class="join-head"><span>Get early access</span><a href="#example">See it work ↓</a></div>
            <Waitlist />
            <p class="foot-note">Design partners get a free scan of their repo.</p>
          </div>
        </div>

        <HeroStory />
      </div>

      <!-- Impact in numbers. Mock data until the first real scans are published. -->
      <div class="impact-strip" aria-label="Example scan">
        <span class="eyebrow">Example scan · Next.js + Stripe starter</span>
        <div class="stats">
          <div><b>14</b><span>rules written</span></div>
          <div><b>3</b><span>broken</span></div>
          <div><b>$1,240</b><span>in double charges a month, at its traffic</span></div>
          <div><b>0</b><span>caught by its 312 tests</span></div>
        </div>
      </div>
    </header>

    <section id="catches" aria-labelledby="bugs-h">
      <div class="wrap">
        <div class="head-row">
          <div>
            <h2 class="reveal" id="bugs-h">Your tests pass. Your data still breaks.</h2>
            <p class="lede">These only happen when the network, a provider or two users get in the way. Unit tests never see them.</p>
          </div>
          <div class="arrows"><button class="glass" type="button" aria-label="Previous" data-dir="-1">←</button><button class="glass" type="button" aria-label="Next" data-dir="1">→</button></div>
        </div>
        <div class="cards" id="cards">
          {bugs.map((b, i) => (
            <article class="bug glass">
              <div class="k1">{b.k}<span>{String(i + 1).padStart(2, '0')}</span></div>
              <div class="q">{b.q}</div>
              <p>{b.p}</p>
              <div class="by"><span>Fault · {b.fault}</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="example" aria-labelledby="demo-h">
      <div class="wrap">
        <h2 class="reveal" id="demo-h">Watch one break</h2>
        <p class="lede">Pledge drops a reply, the customer retries, and the card is charged twice. Then it checks all 40 runs.</p>
        <Demo />
      </div>
    </section>

    <section id="how" aria-labelledby="how-h">
      <div class="wrap center">
        <h2 class="reveal" id="how-h">How it works</h2>
        <p class="lede">Claude writes the rules. Plain code decides pass or fail. Only rules you approve can block a merge.</p>
        <div class="pillars">
          <div class="pillar glass fade">
            <div class="art">
              <svg class="diag" viewBox="0 0 300 150" aria-hidden="true">
                <defs><marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0l8 4-8 4" fill="none" stroke="currentColor" /></marker></defs>
                <Fragment set:html={ruleDiag} />
              </svg>
            </div>
            <div class="n">01</div><h3>Write the rules</h3>
            <p>Claude reads your code and writes the rules your data must keep, like “one charge per payment”.</p>
          </div>
          <div class="pillar glass fade">
            <div class="art forks-art">
              <div id="forks"></div>
              <output id="forks-read" aria-live="polite"></output>
            </div>
            <div class="n">02</div><h3>Break it on purpose</h3>
            <p>Your app runs 40 times in a sandbox, each run hit with retries, duplicate webhooks, races and restarts. Point at the blocks.</p>
          </div>
          <div class="pillar glass fade">
            <div class="art">
              <svg class="diag" viewBox="0 0 300 150" aria-hidden="true"><Fragment set:html={proofDiag} /></svg>
            </div>
            <div class="n">03</div><h3>Get proof</h3>
            <p>When a rule breaks, your pull request fails with the runs, the cause and the exact command to replay it.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="why" aria-labelledby="why-h">
      <div class="wrap">
        <h2 class="reveal" id="why-h">Why not more tests, or a chaos tool?</h2>
        <div class="compare" role="table" aria-label="Pledge compared with tests and chaos tools">
          <div class="c-row c-head" role="row"><span role="columnheader"></span><span role="columnheader">Your tests</span><span role="columnheader">Chaos tools</span><span role="columnheader" class="us">Pledge</span></div>
          {compare.map(([k, a, b, c]) => (
            <div class="c-row" role="row"><span role="rowheader">{k}</span><span role="cell">{a}</span><span role="cell">{b}</span><span role="cell" class="us">{c}</span></div>
          ))}
        </div>
      </div>
    </section>

    <section id="trust" aria-labelledby="trust-h">
      <div class="wrap">
        <div class="feature glass fade">
          <div class="code" aria-label="Example rule file">
            <div class="path"><span>.pledge/pledges/one-charge-per-payment.yaml</span><span>yaml</span></div>
            <div><span class="key">statement</span>: <span class="str">"A payment is charged exactly once."</span></div>
            <div><span class="key">check</span>:</div>
            <div>&nbsp;&nbsp;<span class="key">observer</span>: fake_payments.charges</div>
            <div>&nbsp;&nbsp;<span class="key">group_by</span>: payment_id</div>
            <div>&nbsp;&nbsp;<span class="key">expect</span>: {'{'} count: 1 {'}'}</div>
            <div><span class="key">status</span>: approved&nbsp;&nbsp;<span class="cm"># you approved it</span></div>
          </div>
          <div class="feature-txt">
            <h3 id="trust-h">Built for engineers</h3>
            <ul class="trust">
              {trust.map(([h, p]) => <li><b>{h}</b><span>{p}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="wl-h">
      <div class="wrap">
        <div class="cta">
          <div>
            <h2 id="wl-h">Get a free scan of your repo.</h2>
            <p class="lede">Design partners get Pledge run on their app before launch, with a report of every rule it breaks.</p>
          </div>
          <a class="btn btn-dark" href="#join" data-focus-join>Get early access ↑</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import '../scripts/ui.ts';
    import '../scripts/hero-figure.ts';
    import '../scripts/demo.ts';
    import '../scripts/hero-story.ts';
  </script>
</Base>
