---
import Base from '../layouts/Base.astro';
import Waitlist from '../components/Waitlist.astro';
import Demo from '../components/Demo.astro';
import Mark from '../components/Mark.astro';

const title = 'Pledge — prove your app keeps its promises';
const description =
  'Retries, duplicate webhooks and race conditions quietly double-charge customers and oversell stock. Pledge finds these bugs before your users do.';

const steps = [
  { n: '01', h: 'Write the rules', p: 'Claude reads your code and writes the rules your data must keep, like “one charge per payment”.' },
  { n: '02', h: 'Break it on purpose', p: 'Your app runs in a sandbox while Pledge hits it with retries, duplicate webhooks, races and restarts.' },
  { n: '03', h: 'Get proof', p: 'Plain code checks the data. When a rule breaks, you get the exact steps to replay it.' },
];

const bugs = [
  { k: 'Double charge', q: 'One charge per payment.', p: 'A retry charges the card again.', fault: 'retry' },
  { k: 'Oversold stock', q: 'Stock never goes below zero.', p: 'Two checkouts buy the last item.', fault: 'race' },
  { k: 'Work done twice', q: 'Each webhook is processed once.', p: 'A webhook arrives twice. The order ships twice.', fault: 'duplicate' },
  { k: 'Credits spent twice', q: 'A credit is spent at most once.', p: 'Parallel requests spend one balance twice.', fault: 'race' },
  { k: 'Half-finished write', q: 'Every paid order has a receipt.', p: 'A restart after the charge. Money taken, no order.', fault: 'restart' },
  { k: 'Wrong final state', q: 'A refunded order stays refunded.', p: 'Events arrive out of order and the late one wins.', fault: 'reorder' },
];
---
<Base title={title} description={description}>
  <!-- Pledge mark: an asterisk, the fine print of a promise, with one arm in seal red. Static copy for small uses. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M12 4v16M5.1 8l13.8 8" />
      <path d="M5.1 16L18.9 8" stroke="var(--seal, #C8361D)" />
    </symbol>
  </svg>

  <nav class="nav" aria-label="Main">
    <div class="nav-in glass ticks">
      <a class="logo" href="/" aria-label="Pledge home"><Mark />pledge</a>
      <div class="links">
        <a href="#demo">Example</a>
        <a href="#how">How it works</a>
        <a href="#catches">What it catches</a>
      </div>
      <div class="nav-cta">
        <button class="theme" id="theme" type="button" aria-label="Toggle dark mode">
          <svg class="sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <svg class="moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        </button>
        <a class="btn btn-dark" href="#join">Join waitlist</a>
      </div>
    </div>
  </nav>

  <main>
    <header class="hero wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow marked"><Mark size={14} tick />Fault testing for your data</div>
          <h1>Your app made promises.<span>Prove it keeps them.</span></h1>
          <p class="sub">{description}</p>

          <div class="join glass ticks" id="join">
            <div class="join-head"><span>Join the waitlist</span><a href="#demo">See it work ↓</a></div>
            <Waitlist />
          </div>
        </div>

        <figure class="hero-figure">
          <div class="figure-bar"><span>40 test runs · 1 app</span><output id="forks-read" aria-live="polite"></output></div>
          <div id="forks"></div>
          <figcaption>Each block is one test run. The red ones broke a rule.</figcaption>
        </figure>
      </div>

      <Demo />
    </header>

    <section id="how" aria-labelledby="how-h">
      <div class="wrap center">
        <h2 class="reveal" id="how-h">How it works</h2>
        <div class="pillars">
          {steps.map((x) => (
            <div class="pillar glass fade"><div class="n">{x.n}</div><h3>{x.h}</h3><p>{x.p}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section id="catches" aria-labelledby="bugs-h">
      <div class="wrap">
        <div class="head-row">
          <h2 class="reveal" id="bugs-h">Bugs your tests pass</h2>
          <div class="arrows"><button class="glass" type="button" aria-label="Previous" data-dir="-1">←</button><button class="glass" type="button" aria-label="Next" data-dir="1">→</button></div>
        </div>
        <div class="cards" id="cards">
          {bugs.map((b, i) => (
            <article class="bug glass">
              <div class="k1">{b.k}<span>{String(i + 1).padStart(2, '0')}</span></div>
              <div class="q">{b.q}</div>
              <p>{b.p}</p>
              <div class="by"><span>Fault · {b.fault}</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="file" aria-labelledby="file-h">
      <div class="wrap">
        <div class="feature glass fade">
          <div class="code texture" aria-label="Example rule file">
            <div class="path"><span>.pledge/pledges/one-charge-per-payment.yaml</span><span>yaml</span></div>
            <div><span class="key">statement</span>: <span class="str">"A payment is charged exactly once."</span></div>
            <div><span class="key">check</span>:</div>
            <div>&nbsp;&nbsp;<span class="key">observer</span>: fake_payments.charges</div>
            <div>&nbsp;&nbsp;<span class="key">group_by</span>: payment_id</div>
            <div>&nbsp;&nbsp;<span class="key">expect</span>: {'{'} count: <span class="acc">1</span> {'}'}</div>
            <div><span class="key">status</span>: <span class="acc">approved</span></div>
          </div>
          <div class="feature-txt">
            <h3 id="file-h">The rules live in your repo.</h3>
            <p>Plain files, reviewed like code. Only rules you approve can block a merge.</p>
            <div class="row"><a class="btn btn-dark" href="#join">Join the waitlist →</a></div>
          </div>
        </div>
      </div>
    </section>

    <section id="security" aria-labelledby="sec-h">
      <div class="wrap">
        <div class="sec">
          <h2 class="reveal" id="sec-h">Safe by default</h2>
          <div class="sigils">
            <div class="sigil glass"><svg width="48" height="48" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8" y="8" width="40" height="40" rx="2" /><rect x="18" y="18" width="20" height="20" rx="1" stroke-dasharray="3 3" /></svg>Isolated<br />sandbox</div>
            <div class="sigil glass"><svg width="48" height="48" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="28" cy="28" r="20" /><path d="M8 28h40M28 8c-7 8-7 32 0 40M28 8c7 8 7 32 0 40" /><path d="M12 12l32 32" stroke="var(--seal)" stroke-width="2" /></svg>No network<br />access</div>
            <div class="sigil glass"><svg width="48" height="48" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="10" y="16" width="36" height="24" rx="2" /><path d="M10 23h36" /><path d="M16 33h10" stroke-dasharray="2 3" /></svg>No real<br />charges</div>
            <div class="sigil glass"><svg width="48" height="48" aria-hidden="true"><use href="#mark" /></svg>No production<br />secrets</div>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="wl-h">
      <div class="wrap">
        <div class="cta texture">
          <div>
            <svg width="30" height="30" aria-hidden="true" style="color:#F4EFE9"><use href="#mark" /></svg>
            <h2 id="wl-h">Find out which promises your app breaks.</h2>
          </div>
          <a class="btn" href="#join" data-focus-join>Join the waitlist ↑</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <div class="foot texture">
      <div></div>
      <div class="cols">
        <div><h4>Product</h4><a href="#demo">Example</a><a href="#how">How it works</a><a href="#catches">What it catches</a></div>
        <div><h4>Pledge</h4><a href="#join">Waitlist</a></div>
      </div>
      <div class="foot-bottom">
        <span class="logo"><svg width="24" height="24" aria-hidden="true"><use href="#mark" /></svg>pledge</span>
        <small>© {new Date().getFullYear()} Pledge</small>
      </div>
    </div>
  </footer>

  <script>
    import '../scripts/ui.ts';
    import '../scripts/hero-figure.ts';
    import '../scripts/demo.ts';
  </script>
</Base>
