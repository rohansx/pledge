# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Public URL the site is served from. Used for canonical links, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://your-domain.com

# Lobby waitlist (https://trylobby.app/docs)
# Base URL of the Lobby instance. Change only if you self-host Lobby.
PUBLIC_LOBBY_URL=https://trylobby.app
# Project public key (pk_...). It can only add people to the list, so it is safe in the page.
PUBLIC_LOBBY_PROJECT_KEY=pk_your_public_key

# Project secret key (sk_...) for the admin API and CLI. Server-only: never prefix with PUBLIC_.
# The static site does not use it; it is here for scripts and `lobby` CLI runs
# (e.g. LOBBY_URL=$PUBLIC_LOBBY_URL LOBBY_KEY=$LOBBY_SECRET_KEY lobby stats).
LOBBY_SECRET_KEY=sk_your_secret_key
